# ===== 复制为 .env 后填写，chmod 600，绝不入库 =====

# --- 企业微信主体 ---
WECOM_CORP_ID=wwdab8ed1464222a76

# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 阿龙管家（life）---
WECOM_LIFE_AGENT_ID=1000004
WECOM_LIFE_SECRET=
WECOM_LIFE_TOKEN=
WECOM_LIFE_AESKEY=

# --- 埼玉教练（fitness）---
WECOM_FITNESS_AGENT_ID=
WECOM_FITNESS_SECRET=
WECOM_FITNESS_TOKEN=
WECOM_FITNESS_AESKEY=

# --- 阿尼亚督导（mood）---
WECOM_MOOD_AGENT_ID=
WECOM_MOOD_SECRET=
WECOM_MOOD_TOKEN=
WECOM_MOOD_AESKEY=

# --- 运行参数 ---
KARVIS_HOST=0.0.0.0
KARVIS_PORT=9000
KARVIS_DATA_DIR=/opt/karvis/data
KARVIS_TIMEZONE=Asia/Shanghai

# 你的企微账号（用于定时主动推送；不填则后台任务不推送）
KARVIS_OWNER_USERID=

# 定时开关（P0 可全关）
ENABLE_SCHEDULER=0

# 日志
LOG_LEVEL=INFO
